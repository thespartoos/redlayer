---
// Cabecera común de las páginas secundarias: h1 + entradilla opcional.
interface Props {
	titulo: string;
	entradilla?: string;
	class?: string;
}
const { titulo, entradilla, class: cls } = Astro.props;
---

<header class:list={['max-w-[68ch]', cls]}>
	<slot name="antes" />
	<h1 class="text-3xl leading-tight font-[750] tracking-[-0.02em] text-tinta sm:text-4xl">{titulo}</h1>
	{entradilla && <p class="mt-3 text-lg leading-relaxed text-niebla">{entradilla}</p>}
	<slot />
</header>
