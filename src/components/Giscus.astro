---
import { GISCUS } from '../consts';
const activo = GISCUS.repo && GISCUS.repoId && GISCUS.categoryId;
---

{
	activo && (
		<section aria-labelledby="comentarios" class="mt-14">
			<h2 id="comentarios" class="text-xl font-bold">
				Comentarios
			</h2>
			<div class="mt-5" data-giscus />
			<script
				is:inline
				define:vars={{ g: GISCUS }}
			>
				// Carga diferida: solo cuando el lector llega a los comentarios
				const cont = document.querySelector('[data-giscus]');
				const io = new IntersectionObserver((e) => {
					if (!e[0].isIntersecting) return;
					io.disconnect();
					const s = document.createElement('script');
					const oscuro = document.documentElement.classList.contains('dark');
					Object.entries({
						src: 'https://giscus.app/client.js',
						'data-repo': g.repo,
						'data-repo-id': g.repoId,
						'data-category': g.category,
						'data-category-id': g.categoryId,
						'data-mapping': 'pathname',
						'data-strict': '1',
						'data-reactions-enabled': '1',
						'data-input-position': 'top',
						'data-theme': oscuro ? 'dark_dimmed' : 'light',
						'data-lang': 'es',
						'data-loading': 'lazy',
						crossorigin: 'anonymous',
					}).forEach(([k, v]) => s.setAttribute(k, v));
					s.async = true;
					cont.append(s);
				}, { rootMargin: '400px' });
				io.observe(cont);
			</script>
		</section>
	)
}
