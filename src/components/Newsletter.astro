---
import Icon from './Icon.astro';
import { NEWSLETTER } from '../consts';
---

<section id="newsletter" class="panel scroll-mt-24 p-5" aria-labelledby="newsletter-titulo">
	<div class="flex items-start gap-3">
		<Icon name="mail" size={22} class="mt-0.5 shrink-0 text-senal" />
		<div>
			<h2 id="newsletter-titulo" class="text-base font-bold">Suscríbete a la newsletter</h2>
			<p class="mt-1.5 text-sm leading-relaxed text-niebla">
				Un correo cuando publico un artículo nuevo. Sin spam y te das de baja con un clic.
			</p>
		</div>
	</div>
	<form class="mt-4 flex flex-col gap-2.5" method="post" action={NEWSLETTER.action || undefined} data-newsletter>
		<label for="nl-email" class="sr-only">Tu correo electrónico</label>
		<input
			id="nl-email"
			name="EMAIL"
			type="email"
			required
			autocomplete="email"
			placeholder="tu@correo.com"
			class="w-full rounded-control border border-junta bg-abismo px-3.5 py-2.5 text-[0.9375rem] text-tinta placeholder:text-niebla/70 focus:border-senal focus:outline-none"
		/>
		<!-- Trampa anti-bots: los humanos no la ven -->
		<input type="text" name="email_address_check" value="" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
		<input type="hidden" name="locale" value="es" />
		<button type="submit" class="boton justify-center">Suscribirme</button>
		<p class="text-xs leading-relaxed text-niebla">
			Recibirás un correo para confirmar la suscripción. Más información en la{" "}
			<a href="/privacidad/" class="underline underline-offset-2 hover:text-tinta">política de privacidad</a>.
		</p>
		<p class="hidden text-sm text-amber-500" role="status" data-nl-estado></p>
	</form>
</section>

<script>
	document.querySelectorAll<HTMLFormElement>('[data-newsletter]').forEach((f) => {
		f.addEventListener('submit', (e) => {
			if (!f.getAttribute('action')) {
				e.preventDefault();
				const estado = f.querySelector<HTMLElement>('[data-nl-estado]');
				if (estado) {
					estado.textContent = 'La newsletter aún no está activa. Vuelve pronto.';
					estado.classList.remove('hidden');
				}
			}
		});
	});
</script>
