---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CabeceraPagina from '../../components/CabeceraPagina.astro';
import Pildora from '../../components/Pildora.astro';
import PostMeta from '../../components/PostMeta.astro';
import { getPosts, postUrl, readingTime, type Post } from '../../lib/posts';
import { agruparSeries } from '../../lib/agrupar';
import { migas } from '../../lib/migas';

export const getStaticPaths = (async () => {
	const series = agruparSeries(await getPosts());
	return series.map((s) => ({ params: { serie: s.slug }, props: { nombre: s.nombre, posts: s.posts } }));
}) satisfies GetStaticPaths;

interface Props {
	nombre: string;
	posts: Post[];
}
const { nombre, posts } = Astro.props;
const { serie } = Astro.params;
const n = posts.length;
const partes = `${n} ${n === 1 ? 'parte' : 'partes'}`;

const title = `Serie: ${nombre}`;
// Con nombres largos se usa la variante corta para no pasar de ~160 caracteres.
const description = [
	`«${nombre}», serie de ${partes} en RedLayer para leer en orden: pentesting y hacking ético en español, paso a paso y con laboratorios.`,
	`«${nombre}», serie de ${partes} en RedLayer para leer en orden, paso a paso y con laboratorios.`,
].find((d) => d.length <= 160) ?? `«${nombre}», serie de ${partes} en RedLayer.`;
const jsonLd = [
	migas(['Series', '/series/'], [nombre, `/series/${serie}/`]),
	{
		'@context': 'https://schema.org',
		'@type': 'ItemList',
		name: nombre,
		itemListOrder: 'https://schema.org/ItemListOrderAscending',
		itemListElement: posts.map((p, i) => ({
			'@type': 'ListItem',
			position: i + 1,
			url: new URL(postUrl(p), Astro.site).href,
			name: p.data.title,
		})),
	},
];
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
	<div class="mx-auto max-w-[1280px] px-4 pt-10 sm:px-6 lg:pt-14">
		<CabeceraPagina titulo={nombre} entradilla={n === 1 ? `Serie en curso: de momento tiene 1 parte.` : `Serie de ${partes}. Léelas en orden.`}>
			<p slot="antes" class="mb-3 text-sm font-medium">
				<a href="/series/" class="text-senal hover:underline">Todas las series</a>
			</p>
		</CabeceraPagina>

		<ol class="mt-8 max-w-3xl space-y-4">
			{
				posts.map((p) => (
					<li class="relative flex gap-4 rounded-tarjeta border border-junta bg-casco p-5 transition-colors hover:border-senal/60 focus-within:border-senal/60">
						<span class="grid size-9 shrink-0 place-items-center rounded-control border border-junta font-mono text-sm text-tinta">
							<span class="sr-only">Parte </span>
							{p.data.series?.order}
						</span>
						<div class="min-w-0 flex-1">
							<Pildora categoria={p.data.category} />
							<h2 class="mt-2 text-lg leading-snug font-bold text-tinta">
								<a href={postUrl(p)} class="after:absolute after:inset-0 focus-visible:outline-none">
									{p.data.title}
								</a>
							</h2>
							<p class="mt-1.5 text-[0.9375rem] leading-relaxed text-niebla">{p.data.description}</p>
							<PostMeta date={p.data.date} minutos={readingTime(p.body)} class="mt-3" />
						</div>
					</li>
				))
			}
		</ol>
	</div>
</BaseLayout>
